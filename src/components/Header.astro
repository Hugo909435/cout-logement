---
import { SILO_META, SILO_ORDER } from '../lib/silos';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="wordmark">
      Cout <em>Logement</em>
    </a>
    <nav class="flex flex-wrap items-center gap-5 text-sm">
      {
        SILO_ORDER.map((silo) => (
          <a href={`/${silo}/`} class="nav-link">
            {SILO_META[silo].label}
          </a>
        ))
      }
      <a href="/departement/" class="nav-link">Départements</a>
      <ThemeToggle />
    </nav>
  </div>
</header>
