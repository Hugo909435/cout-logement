---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import { formatDateFr } from '../lib/dates';
import {
  AUTHOR_NAME,
  AUTHOR_ROLE,
  AUTHOR_EMAIL,
  AUTHOR_PATH,
  AUTHOR_ID_FRAGMENT,
  AUTHOR_PHOTO,
  AUTHOR_LINKEDIN,
  AUTHOR_GITHUB,
} from '../lib/author';

const description =
  'Qui écrit Cout Logement, ce que ce site publie et ce qu’il ne fait pas : pas de conseil fiscal, financier ou juridique personnalisé.';
const updatedDate = new Date('2026-09-09');

const authorId = new URL(`${AUTHOR_PATH}${AUTHOR_ID_FRAGMENT}`, Astro.site).toString();
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': authorId,
  name: AUTHOR_NAME,
  description: AUTHOR_ROLE,
  email: `mailto:${AUTHOR_EMAIL}`,
  url: new URL(AUTHOR_PATH, Astro.site).toString(),
  image: new URL(AUTHOR_PHOTO, Astro.site).toString(),
  sameAs: [AUTHOR_LINKEDIN, AUTHOR_GITHUB],
};
---

<BaseLayout>
  <SEO slot="head" title="Qui écrit ce site" description={description} path="/auteur/" />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(personJsonLd)} />
  <article class="article">
    <span class="badge">
      Mis à jour le {formatDateFr(updatedDate)}
    </span>
    <h1 class="mt-4 text-3xl font-semibold sm:text-4xl">Qui écrit ce site</h1>
    <div class="brand-bar mt-4 max-w-24"></div>

    <div class="mt-6 flex items-center gap-4">
      <img
        src={AUTHOR_PHOTO}
        alt={AUTHOR_NAME}
        width="80"
        height="80"
        class="h-20 w-20 rounded-full border border-border object-cover"
      />
      <div class="flex flex-col gap-2 text-sm">
        <span class="font-medium">{AUTHOR_NAME}</span>
        <div class="flex gap-3 text-text-muted">
          <a href={AUTHOR_LINKEDIN} aria-label="Profil LinkedIn" class="nav-link" target="_blank" rel="noopener noreferrer me">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
          <a href={AUTHOR_GITHUB} aria-label="Profil GitHub" class="nav-link" target="_blank" rel="noopener noreferrer me">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.535-1.5.115-3.12 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.65 1.62.24 2.82.12 3.12.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <p>
      Ce site est écrit et maintenu par <strong>{AUTHOR_NAME}</strong>. Je n'ai inventé aucune
      persona ni aucun titre professionnel que je ne détiens pas : je suis développeur, et c'est
      en tant que développeur que je construis et que je maintiens les jeux de données publiés
      ici, à partir des sources listées sur la page <a href="/sources/">Sources officielles</a>.
    </p>

    <p>
      Je ne suis ni fiscaliste, ni conseiller en gestion de patrimoine, ni avocat. L'autorité de
      ce site ne vient pas d'un diplôme que je n'ai pas, elle vient de la donnée : chaque chiffre
      cité est traçable jusqu'à une source officielle nommée, avec son millésime, sa fréquence de
      mise à jour et les limites décrites sur la page <a href="/methodologie/">Méthodologie</a>.
      Je préfère l'assumer plutôt que de me présenter comme un expert que je ne suis pas.
    </p>

    <h2>Ce que ce site fait</h2>
    <p>
      Cout Logement publie des données publiques et des faits sourcés sur la fiscalité locale,
      l'énergie du logement et les aides à la rénovation, mis en forme pour être lisibles sans
      avoir à ouvrir un fichier statistique.
    </p>

    <h2>Ce que ce site ne fait pas</h2>
    <div class="callout">
      <p>
        <strong>
          Ce site ne délivre aucun conseil fiscal, financier ou juridique personnalisé.
        </strong>
      </p>
      <p>
        Ce que vous lisez ici décrit une règle générale ou un chiffre agrégé, pas votre situation.
        Pour une décision qui vous concerne, rapprochez-vous de l'administration compétente ou
        d'un professionnel qualifié.
      </p>
    </div>

    <h2>Contact</h2>
    <div class="card">
      <p>
        Une erreur, une source à ajouter, une question sur une donnée : écrivez-moi à
        <a href={`mailto:${AUTHOR_EMAIL}`}>{AUTHOR_EMAIL}</a>.
      </p>
    </div>
  </article>
</BaseLayout>
