---
import { getCollection, getEntry, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import type { Silo } from '../../content.config';

export async function getStaticPaths() {
  const piliers = await getCollection('piliers', ({ data }) => !data.draft);
  const blog = await getCollection('blog', ({ data }) => !data.draft);

  return [
    ...piliers.map((entry) => ({
      params: { silo: entry.data.silo, slug: entry.id },
      props: { collection: 'piliers' as const, id: entry.id },
    })),
    ...blog.map((entry) => ({
      params: { silo: entry.data.silo, slug: entry.id },
      props: { collection: 'blog' as const, id: entry.id },
    })),
  ];
}

const { collection, id } = Astro.props;
const entry = await getEntry(collection, id);

if (!entry) {
  return Astro.redirect('/404');
}

const { Content, remarkPluginFrontmatter } = await render(entry);
const { silo } = Astro.params as { silo: Silo };
const faq = remarkPluginFrontmatter.faq as { question: string; answer: string }[] | undefined;
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  path={`/${silo}/${entry.id}/`}
  silo={entry.data.silo}
  author={entry.data.author}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
  heroImage={entry.data.heroImage}
  faq={faq}
>
  <Content />
</ArticleLayout>
